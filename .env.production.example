# Copy to `.env` next to docker-compose.prod.yml (gitignored) and fill in.
# Used by `docker compose -f docker-compose.prod.yml up -d`.
#
# This exposes the FRONTEND to the internet — the backend stays on the
# company LAN (see BE-kt-xnk's docker-compose.lan.yml + docs/deployment.md).
# The browser never calls the backend directly (see
# src/app/api/backend/[...path]/route.js), so it never needs to be reachable
# from outside the LAN.

# The backend's address on the company LAN, e.g. http://192.168.88.50:8080
# — this container calls it server-side, over the LAN, not the internet.
API_BASE_URL=http://192.168.88.50:8080


# [admin@MikroTik] > /ip cloud
# [admin@MikroTik] /ip cloud> set ddns-enabled=yes
# [admin@MikroTik] /ip cloud> print
#           ddns-enabled: yes
#   ddns-update-interval: none
#            update-time: yes
#         public-address: 14.224.162.71
#               dns-name: hd6089xzez8.sn.mynetname.net
#                 status: updated


# /ip firewall nat
# add chain=dstnat in-interface=pppoe-out2 protocol=tcp dst-port=80 action=dst-nat to-addresses=192.168.100.34 to-ports=80 comment="Frontend HTTP (ACME + redirect)"
# add chain=dstnat in-interface=pppoe-out2 protocol=tcp dst-port=443 action=dst-nat to-addresses=192.168.100.34 to-ports=443 comment="Frontend HTTPS"