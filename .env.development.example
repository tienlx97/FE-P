# Copy to `.env.development.local` (gitignored) for local `pnpm dev` work.
# Next.js loads this file automatically ONLY when NODE_ENV=development
# (i.e. `next dev`), so it never affects the production process (`next
# start`, which reads `.env` instead) — the two can run at the same time on
# the same machine without stepping on each other.

# Point at the BE-kt-xnk dev stack (docker-compose.dev.yml), not the LAN
# production API on :8080. Default dev API host port is 8081 — see
# BE-kt-xnk/docker-compose.dev.yml.
API_BASE_URL=http://localhost:8081
